# ---------------------------------------------------------------------------
# Save no Jutsu — environment
# Copy to .env.local for local development. Never commit .env.local.
# ---------------------------------------------------------------------------

# hosted = public Vercel product (site Jev key + Stripe)
# byok   = self-hosted / GitHub version (operator's own Jev key, no Stripe)
APP_MODE=byok

# TypeSafe / Jev API key. SERVER ONLY. Never put this in NEXT_PUBLIC_*.
# Get a key at https://typesafe.ai — do not paste it into the browser.
TYPESAFE_API_KEY=

# Pinned Jev model. Default is the current supported version.
JEV_MODEL=jev-1.13.0

# TypeSafe endpoint (override only if TypeSafe documents a different URL)
# TYPESAFE_API_URL=https://api.typesafe.ai/v1/systemone

# Public site URL (used for Stripe success/cancel return links)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Product setting: model-confidence below this is labeled "needs review".
# This is NOT a validated accuracy cutoff.
NEEDS_REVIEW_THRESHOLD=0.45

# ---------------------------------------------------------------------------
# Hosted billing (ignored when APP_MODE=byok)
# ---------------------------------------------------------------------------
STRIPE_SECRET_KEY=
# Optional. Not required for Checkout Session retrieval verification.
STRIPE_WEBHOOK_SECRET=

# Optional Stripe Price IDs. If unset, Checkout uses server-side price_data
# with the documented one-time amounts ($5 Standard, $8 Deep analysis).
# STRIPE_PRICE_STANDARD=
# STRIPE_PRICE_DEEP=

# HMAC secret for short-lived payment entitlement tokens (no content stored).
# Falls back to STRIPE_SECRET_KEY in hosted mode.
ENTITLEMENT_SECRET=

# Optional Vercel KV REST credentials. If unset, entitlement/rate-limit
# metadata lives in process memory (single-instance only) and is lost on
# restart. KV stores only hashed IPs, plan id, counters, and expiry — never
# JSON, captions, labels, or reports. TTL is 2 hours.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# Optional Cloudflare Turnstile (hosted abuse protection). Site key is public.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=

# ---------------------------------------------------------------------------
# Test mode — clearly labeled in the UI. Does NOT pretend to be production.
# Enable only for local development when Stripe and/or TypeSafe keys are absent.
# - Missing TYPESAFE_API_KEY: classification uses a heuristic labeled TEST MODE
# - Missing STRIPE_SECRET_KEY in hosted mode: simulated checkout, labeled TEST MODE
# Never enable TEST_MODE on a public production deployment.
# ---------------------------------------------------------------------------
TEST_MODE=true
